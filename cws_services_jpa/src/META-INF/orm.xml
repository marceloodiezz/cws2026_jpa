<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings xmlns="https://jakarta.ee/xml/ns/persistence/orm"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence/orm https://jakarta.ee/xml/ns/persistence/orm/orm_3_1.xsd"
	version="3.1">
	
	<package>uo.ri.cws.domain</package>
    <access>FIELD</access>

	<!-- Client queries -->
	<named-query name="Client.findByNif">
		<query>
			select c
			from Client c
			where c.nif = ?1
		</query>
	</named-query>
	
	<named-query name="Client.findWithRecommendationsUnusedForVoucher">
	    <query>
	        select c
	        from Client c
	        where (
	            select count(r)
	            from Recommendation r
	            where r.recommender = c
	              and r.usedForVoucher = false
	        ) >= ?1
	    </query>
	</named-query>
	
	<!-- CreditCard queries -->
	<named-query name="CreditCard.findByNumber">
	    <query>
	        select c
	        from CreditCard c
	        where c.number = ?1
	    </query>
	</named-query>
	
	<!-- Invoice queries -->
	<named-query name="Invoice.findByNumber">
		<query>select f from Invoice f where f.number = ?1</query>
	</named-query>

	<named-query name="Invoice.getNextInvoiceNumber">
		<query>
			select cast( coalesce(max(f.number) + 1, 1L) as bigint ) 
			from Invoice f
		</query>
<!-- 	
		This breaks if there is none invoice
		<query>select max(f.number) + 1 from Invoice f</query>
-->
	</named-query>

	<named-query name="Invoice.findOverAmountUnusedForVoucher">
		<query>
			<![CDATA[
			select invoice
			from Invoice invoice
			where invoice.total.amount > ?1
				and invoice.usedForVoucher = false
			]]>
		</query>
	</named-query>

	<!-- Mechanic queries -->
	<named-query name="Mechanic.findByNif">
		<query>
			select m
			from Mechanic m
			where m.nif = ?1
		</query>
	</named-query>

	<named-query name="Mechanic.countInterventions">
		<query>
			select count(i)
			from Intervention i
			where i.mechanic.id = ?1
		</query>
	</named-query>

	<!-- PaymentMean queries -->
	<named-query name="PaymentMean.findByInvoiceId">
	    <query>
	        select m
	        from Invoice f
	            join f.workOrders w
	            join w.vehicle.client c
	            join c.paymentMeans m
	        where f.id = ?1
	    </query>
	</named-query>
	
	<named-query name="PaymentMean.findByNif">
		<query>
			select pm
			from PaymentMean pm
			where pm.client.nif = ?1
		</query>
	</named-query>
	
	<named-query name="PaymentMean.hasCharges">
	    <query>
	        select count(c)
	        from Charge c
	        where c.paymentMean.id = ?1
	    </query>
	</named-query>

	<!-- Vehicle queries -->
	<named-query name="Vehicle.findByPlate">
		<query>select v from Vehicle v where v.licensePlate = ?1</query>
	</named-query>
	
	<!-- Voucher queries -->
	<named-query name="Voucher.findByClientNif">
	    <query>
	        select v
	        from Voucher v
	        where v.client.nif = ?1
	    </query>
	</named-query>
	
	<named-query name="Voucher.findByCode">
	    <query>
	        select v
	        from Voucher v
	        where v.code = ?1
	    </query>
	</named-query>
	
	<named-query name="Voucher.getSummary">
	    <query>
	        select v.client,
	               count(v),
	               sum(v.accumulated.amount),
	               sum(v.availableAmount.amount)
	        from Voucher v
	        group by v.client
	        order by sum(v.availableAmount.amount) desc
	    </query>
	</named-query>

	<!-- WorkOrder queries -->
	<named-query name="WorkOrder.findByIds">
		<query>select w from WorkOrder w where w.id in ?1</query>
	</named-query>

	<named-query name="WorkOrder.findNotInvoicedByClientNif">
		<query>select w 
		       from WorkOrder w
		       join w.vehicle v
		       join v.client c 
		       where c.nif = ?1
		       and w.state = uo.ri.cws.domain.WorkOrder$WorkOrderState.APPROVED
		</query>
	</named-query>

	<!-- 
	Use this format if your query has greater than numeric comparisons the one
	in this example
	
	<named-query name="findItemsOnSaleByCategoryId">
	<query>
			<![CDATA[
			select i 
			from Item i join i.categories c
			where c.id = ?2
				and i.startDate <= ?1
				and i.endDate >= ?1 
			]]>
	</query>
	</named-query>
	-->
	
	
	
	
	<!--
		MAPEO DE CLASES
	-->
	
	
	<!-- BaseEntity -->
	<mapped-superclass class="uo.ri.cws.domain.base.BaseEntity">
	    <attributes>
	        <id name="id" />
	        <version name="version" />
	        <basic name="entityState">
	            <enumerated>STRING</enumerated>
	        </basic>
	    </attributes>
	</mapped-superclass>
	
	
	<!-- VehicleType -->
	<entity class="uo.ri.cws.domain.VehicleType">
	    <table name="TVEHICLETYPES" />
	    <attributes>
	        <basic name="name">
	            <column unique="true" />
	        </basic>
	
	        <embedded name="pricePerHour">
	            <attribute-override name="amount">
	                <column name="PRICE_PER_HOUR" precision="19" scale="2" />
	            </attribute-override>
	        </embedded>
	    </attributes>
	</entity>
	
	<!-- Mechanic -->
	<entity class="uo.ri.cws.domain.Mechanic">
	    <table name="TMECHANICS" />
	
	    <attributes>
	        <embedded name="nif">
	            <attribute-override name="nif">
	                <column unique="true" />
	            </attribute-override>
	        </embedded>
	
	        <embedded name="fullName" />
	
	        <one-to-many name="assigned" mapped-by="mechanic" />
	    </attributes>
	</entity>
	
	<!-- SparePart -->
	<entity class="uo.ri.cws.domain.SparePart">
	    <table name="TSPAREPARTS" />
	
	    <attributes>
	        <basic name="code">
	            <column unique="true" />
	        </basic>
	
	        <basic name="description" />
	
	        <embedded name="unitPrice">
	            <attribute-override name="amount">
	                <column name="PRICE" precision="19" scale="2" />
	            </attribute-override>
	        </embedded>
	
	        <one-to-many name="substitutions" mapped-by="sparePart" />
	    </attributes>
	</entity>
	
	<!-- Vehicle -->
	<entity class="uo.ri.cws.domain.Vehicle">
	    <table name="TVEHICLES" />
	
	    <attributes>
	        <embedded name="licensePlate">
	            <attribute-override name="licensePlate">
	                <column unique="true" />
	            </attribute-override>
	        </embedded>
	
	        <basic name="make" />
	        <basic name="model" />
	
	        <many-to-one name="vehicleType" />
	        <many-to-one name="client" />
	
	        <one-to-many name="workOrders" mapped-by="vehicle" />
	    </attributes>
	</entity>
	
	<!-- Client -->
	<entity class="uo.ri.cws.domain.Client">
	    <table name="TCLIENTS" />
	
	    <attributes>
	        <embedded name="nif">
	            <attribute-override name="nif">
	                <column unique="true" />
	            </attribute-override>
	        </embedded>
	
	        <embedded name="fullName" />
	        <embedded name="email" />
	        <embedded name="phone" />
	        <embedded name="address" />
	
	        <one-to-many name="vehicles" mapped-by="client" />
	        <one-to-many name="paymentMeans" mapped-by="client" />
	        <one-to-many name="recommendations" mapped-by="recommender" />
	        <one-to-one name="recommendation" mapped-by="recommended" />
	    </attributes>
	</entity>
	
	<!-- WorkOrder -->
	<entity class="uo.ri.cws.domain.WorkOrder">
	    <table name="TWORKORDERS">
	        <unique-constraint>
	            <column-name>VEHICLE_ID</column-name>
	            <column-name>date</column-name>
	        </unique-constraint>
	    </table>
	
	    <attributes>
	        <basic name="date" />
	        <basic name="description" />
	
	        <embedded name="amount">
	            <attribute-override name="amount">
	                <column name="TOTAL_AMOUNT" precision="19" scale="2" />
	            </attribute-override>
	        </embedded>
	
	        <basic name="state">
	            <enumerated>STRING</enumerated>
	        </basic>
	
	        <basic name="usedForVoucher" />
	
	        <many-to-one name="invoice" />
	        <many-to-one name="mechanic" />
	        <many-to-one name="vehicle" />
	
	        <one-to-many name="interventions" mapped-by="workOrder" orphan-removal="true">
	            <cascade>
	                <cascade-all />
	            </cascade>
	        </one-to-many>
	    </attributes>
	</entity>
	
	<!-- Intervention -->
	<entity class="uo.ri.cws.domain.Intervention">
	    <table name="TINTERVENTIONS">
	        <unique-constraint>
	            <column-name>WORKORDER_ID</column-name>
	            <column-name>MECHANIC_ID</column-name>
	            <column-name>date</column-name>
	        </unique-constraint>
	    </table>
	
	    <attributes>
	        <basic name="date" />
	        <basic name="minutes" />
	
	        <many-to-one name="workOrder" />
	        <many-to-one name="mechanic" />
	
	        <one-to-many name="substitutions"
	                     mapped-by="intervention"
	                     orphan-removal="true">
	            <cascade>
	                <cascade-all />
	            </cascade>
	        </one-to-many>
	    </attributes>
	</entity>
	
	<!-- Substitution -->
	<entity class="uo.ri.cws.domain.Substitution">
	    <table name="TSUBSTITUTIONS">
	        <unique-constraint>
	            <column-name>INTERVENTION_ID</column-name>
	            <column-name>SPAREPART_ID</column-name>
	        </unique-constraint>
	    </table>
	
	    <attributes>
	        <embedded name="price">
	            <attribute-override name="amount">
	                <column name="PRICE" precision="19" scale="2" />
	            </attribute-override>
	        </embedded>
	
	        <basic name="quantity" />
	
	        <many-to-one name="sparePart" />
	        <many-to-one name="intervention" />
	    </attributes>
	</entity>
	
	<!-- Invoice -->
	<entity class="uo.ri.cws.domain.Invoice">
	    <table name="TINVOICES" />
	
	    <attributes>
	        <basic name="number">
	            <column unique="true" />
	        </basic>
	
	        <basic name="date" />
	
	        <basic name="state">
	            <enumerated>STRING</enumerated>
	        </basic>
	
	        <basic name="usedForVoucher" />
	
	        <embedded name="subtotal">
	            <attribute-override name="amount">
	                <column name="SUBTOTAL" precision="19" scale="2" />
	            </attribute-override>
	        </embedded>
	
	        <embedded name="vatRate">
	            <attribute-override name="value">
	                <column name="VATRATE" precision="19" scale="2" />
	            </attribute-override>
	        </embedded>
	
	        <embedded name="vatAmount">
	            <attribute-override name="amount">
	                <column name="VATAMOUNT" precision="19" scale="2" />
	            </attribute-override>
	        </embedded>
	
	        <embedded name="total">
	            <attribute-override name="amount">
	                <column name="TOTAL" precision="19" scale="2" />
	            </attribute-override>
	        </embedded>
	
	        <one-to-many name="workOrders" mapped-by="invoice" />
	
	        <one-to-many name="charges"
	                     mapped-by="invoice"
	                     orphan-removal="true">
	            <cascade>
	                <cascade-all />
	            </cascade>
	        </one-to-many>
	    </attributes>
	</entity>
	
	<!-- PaymentMean -->
	<entity class="uo.ri.cws.domain.PaymentMean">
	    <table name="TPAYMENTMEANS" />
	
	    <inheritance strategy="JOINED" />
	
	    <attributes>
	        <embedded name="accumulated">
	            <attribute-override name="amount">
	                <column name="ACCUMULATED" precision="19" scale="2" />
	            </attribute-override>
	        </embedded>
	
	        <many-to-one name="client" />
	    </attributes>
	</entity>
	
	<!-- Cash -->
	<entity class="uo.ri.cws.domain.Cash">
	    <table name="TCASHES" />
	</entity>
	
	<!-- CreditCard -->
	<entity class="uo.ri.cws.domain.CreditCard">
	    <table name="TCREDITCARDS" />
	
	    <attributes>
	        <embedded name="number">
	            <attribute-override name="number">
	                <column unique="true" />
	            </attribute-override>
	        </embedded>
	
	        <basic name="type" />
	        <basic name="validThru" />
	    </attributes>
	</entity>
	
	<!-- Voucher -->
	<entity class="uo.ri.cws.domain.Voucher">
	    <table name="TVOUCHERS" />
	
	    <attributes>
	        <embedded name="code">
	            <attribute-override name="code">
	                <column unique="true" />
	            </attribute-override>
	        </embedded>
	
	        <basic name="description" />
	
	        <embedded name="availableAmount">
	            <attribute-override name="amount">
	                <column name="AVAILABLE" precision="19" scale="2" />
	            </attribute-override>
	        </embedded>
	    </attributes>
	</entity>
	
	<!-- Charge -->
	<entity class="uo.ri.cws.domain.Charge">
	    <table name="TCHARGES">
	        <unique-constraint>
	            <column-name>INVOICE_ID</column-name>
	            <column-name>PAYMENTMEAN_ID</column-name>
	        </unique-constraint>
	    </table>
	
	    <attributes>
	        <embedded name="amount">
	            <attribute-override name="amount">
	                <column name="CHARGE" precision="19" scale="2" />
	            </attribute-override>
	        </embedded>
	
	        <many-to-one name="invoice" />
	        <many-to-one name="paymentMean" />
	    </attributes>
	</entity>
	
	<!-- Recommendation -->
	<entity class="uo.ri.cws.domain.Recommendation">
	    <table name="TRECOMMENDATIONS">
	        <unique-constraint>
	            <column-name>RECOMMENDER_ID</column-name>
	            <column-name>RECOMMENDED_ID</column-name>
	        </unique-constraint>
	    </table>
	
	    <attributes>
	        <basic name="usedForVoucher" />
	
	        <many-to-one name="recommender" />
	
	        <one-to-one name="recommended" />
	    </attributes>
	</entity>
	
	
	<!-- Value Types -->
	
	<embeddable class="uo.ri.cws.domain.types.Nif">
	    <attributes>
	        <basic name="nif" />
	    </attributes>
	</embeddable>
	
	<embeddable class="uo.ri.cws.domain.types.LicensePlate">
	    <attributes>
	        <basic name="licensePlate" />
	    </attributes>
	</embeddable>
	
	<embeddable class="uo.ri.cws.domain.types.Email">
	    <attributes>
	        <basic name="email" />
	    </attributes>
	</embeddable>
	
	<embeddable class="uo.ri.cws.domain.types.FullName">
	    <attributes>
	        <basic name="name" />
	        <basic name="surname" />
	    </attributes>
	</embeddable>
	
	<embeddable class="uo.ri.cws.domain.types.PhoneNumber">
	    <attributes>
	        <basic name="phone" />
	    </attributes>
	</embeddable>
	
	<embeddable class="uo.ri.cws.domain.types.Address">
	    <attributes>
	        <basic name="street" />
	        <basic name="city" />
	        <basic name="country" />
	        <basic name="postalCode" />
	    </attributes>
	</embeddable>
	
	<embeddable class="uo.ri.cws.domain.types.CreditCardNumber">
	    <attributes>
	        <basic name="number" />
	    </attributes>
	</embeddable>
	
	<embeddable class="uo.ri.cws.domain.types.VoucherCode">
	    <attributes>
	        <basic name="code" />
	    </attributes>
	</embeddable>
	
	<embeddable class="uo.ri.cws.domain.types.Money">
	    <attributes>
	        <basic name="amount" />
	    </attributes>
	</embeddable>
	
	<embeddable class="uo.ri.cws.domain.types.Percentage">
	    <attributes>
	        <basic name="value" />
	    </attributes>
	</embeddable>

</entity-mappings>
